# Prisma CLI：相对路径相对于 prisma/ 目录 → 实际文件为 prisma/dev.db
DATABASE_URL="file:./dev.db"

# 硅基流动（OpenAI 兼容）。只用于写脚本，不要配生视频模型。
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 主账号。都配上之后，未登录不能进工作台、不能调写脚本接口。
OWNER_ACCOUNT=
OWNER_PASSWORD=
# 签名 cookie。生产环境请设成长随机串。
SESSION_SECRET=
